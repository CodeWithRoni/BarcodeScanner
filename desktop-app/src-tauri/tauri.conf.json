{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BarcodeSync",
  "version": "1.0.0",
  "identifier": "com.codewithroni.barcodesync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "BarcodeSync",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Wireless barcode & QR scanner receiver",
    "longDescription": "BarcodeSync turns your phone into a wireless barcode and QR scanner. Scans are typed into the focused app, copied to the clipboard, or logged.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libxdo3"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
